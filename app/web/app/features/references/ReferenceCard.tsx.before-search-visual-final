"use client";

import type { Reference } from "./data";

interface ReferenceCardProps {
  reference: Reference;
  isInLightTable: boolean;
  onSelect: (reference: Reference) => void;
  onToggleLightTable: (reference: Reference) => void;
}

export default function ReferenceCard({
  reference,
  isInLightTable,
  onSelect,
  onToggleLightTable,
}: ReferenceCardProps) {
  const origin =
    reference.origin ?? "provider";

  const isDirectorProposal =
    origin === "provider";

  const isRevelaSearch =
    origin === "search";

  const originClass =
    isDirectorProposal
      ? "border-cyan-300/40 bg-cyan-300/[0.035] hover:border-cyan-300/70 shadow-[inset_0_1px_0_rgba(85,193,212,0.18)]"
      : isRevelaSearch
        ? "border-2 border-[#55C1D4]/70 bg-[#55C1D4]/[0.07] hover:border-[#55C1D4] shadow-[0_0_22px_rgba(85,193,212,0.08)]"
        : "border-white/10 bg-black/35 hover:border-white/25";
  return (
    <article
      className={[
        "group flex min-h-[340px] flex-col overflow-hidden rounded-2xl border transition-all duration-200",
        originClass,
        origin === "provider"
          ? "shadow-[inset_0_1px_0_rgba(85,193,212,0.18)]"
          : "",
        isInLightTable
          ? "border-cyan-300/70 shadow-[0_0_24px_rgba(85,193,212,0.08)]"
          : "",
      ].join(" ")}
    >
      {isRevelaSearch && (
        <div className="border-b border-[#55C1D4]/30 bg-[#55C1D4]/[0.08] px-5 py-2">
          <span className="text-[9px] font-medium uppercase tracking-[0.28em] text-[#55C1D4]">
            ⌕ RƎVELA
          </span>
        </div>
      )}

      {/* =================================================
          CONTENIDO
      ================================================= */}

      <div className="flex flex-1 flex-col p-5">

        {/* CABECERA */}

        <div className="flex items-center justify-between gap-3">

          <span
            className={[
              "inline-flex items-center rounded-full border px-2.5 py-1 text-[9px] uppercase tracking-[0.22em]",
              isDirectorProposal
                ? "border-cyan-300/50 bg-cyan-300/[0.12] text-cyan-300"
                : "border-white/15 bg-white/[0.025] text-white/40",
            ].join(" ")}
          >
            
          </span>

          <span className="truncate text-[9px] uppercase tracking-[0.25em] text-white/30">
            {reference.category}
          </span>

        </div>



        {/* TÍTULO */}

        <h3 className="mt-5 text-2xl font-light leading-tight text-white">
          {reference.title}
        </h3>

        {/* DESCRIPCIÓN */}

        <p className="mt-3 line-clamp-2 text-sm leading-6 text-white/55">
          {reference.description}
        </p>

        {/* ESPACIO FLEXIBLE */}

        <div className="flex-1" />

        {/* =================================================
            ACCIONES
        ================================================= */}

        <div className="mt-5 flex flex-col gap-2">

          {/* MESA DE LUZ */}

          <button
            type="button"
            onClick={(event) => {
              event.stopPropagation();
              onToggleLightTable(reference);
            }}
            aria-pressed={isInLightTable}
            className={[
              "flex h-10 w-full items-center justify-center rounded-xl border text-[10px] uppercase tracking-[0.25em] transition-all",
              isInLightTable
                ? "border-cyan-300/60 bg-cyan-300/[0.08] text-cyan-300 hover:bg-cyan-300/[0.14]"
                : "border-white/10 text-white/50 hover:border-cyan-300/40 hover:text-cyan-300",
            ].join(" ")}
          >
            {isInLightTable
              ? "− Mesa de Luz"
              : "+ Mesa de Luz"}
          </button>

          {/* EXAMINAR */}

          <button
            type="button"
            onClick={(event) => {
              event.stopPropagation();
              onSelect(reference);
            }}
            className="
              flex
              h-9
              w-full
              items-center
              justify-center
              rounded-xl
              border
              border-white/10
              text-[10px]
              uppercase
              tracking-[0.25em]
              text-white/45
              transition-all
              hover:border-white/25
              hover:text-white
            "
          >
            Examinar →
          </button>

        </div>
      </div>
    </article>
  );
}