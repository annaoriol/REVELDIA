"use client";

import { useRef, useState } from "react";

import { useRevealStore } from "@/app/stores/useRevealStore";

const referenceKinds = [
  {
    value: "visual",
    label: "Visual",
  },
  {
    value: "narrative",
    label: "Narrativa",
  },
  {
    value: "cultural",
    label: "Cultural",
  },
  {
    value: "emotional",
    label: "Emocional",
  },
  {
    value: "conceptual",
    label: "Conceptual",
  },
  {
    value: "editorial",
    label: "Editorial",
  },
  {
    value: "cinematic",
    label: "Cinematográfica",
  },
] as const;

type ReferenceKind =
  (typeof referenceKinds)[number]["value"];

export default function UserEvidencePanel() {
  const registerReference = useRevealStore(
    (state) => state.registerReference
  );

  const addToLightTable = useRevealStore(
    (state) => state.addToLightTable
  );

  const references = useRevealStore(
    (state) => state.project.dna.references
  );

  const fileInputRef =
    useRef<HTMLInputElement | null>(null);

  const [selectedFile, setSelectedFile] =
    useState<File | null>(null);

  const [kind, setKind] =
    useState<ReferenceKind>("visual");

  const [meaning, setMeaning] =
    useState("");

  const [isOpen, setIsOpen] =
    useState(false);

  const handleChooseFile = () => {
    fileInputRef.current?.click();
  };

  const handleFileChange = (
    event: React.ChangeEvent<HTMLInputElement>
  ) => {
    const file =
      event.target.files?.[0] ?? null;

    setSelectedFile(file);
  };

  const handleRegister = () => {
    if (!selectedFile) {
      return;
    }

    /*
     * 1. Guardamos la referencia en el ADN
     * del proyecto.
     *
     * registerReference genera el ID real
     * dentro del store.
     */
    const imageUrl =
      selectedFile.type.startsWith("image/")
        ? URL.createObjectURL(selectedFile)
        : undefined;

    registerReference({
      kind,
      title: selectedFile.name,
      description: selectedFile.name,
      meaning:
        meaning.trim() ||
        `Referencia aportada por la persona: ${selectedFile.name}`,
      image: imageUrl,
      fileName: selectedFile.name,
      mimeType: selectedFile.type,
    });

    /*
     * 2. Recuperamos inmediatamente la referencia
     * que acaba de crear el store.
     *
     * Así utilizamos EXACTAMENTE el mismo ID
     * para la Mesa de Luz.
     */
    const registeredReferences =
      useRevealStore.getState()
        .project.dna.references;

    const registeredReference =
      registeredReferences[
        registeredReferences.length - 1
      ];

    if (!registeredReference) {
      return;
    }

    /*
     * 3. Si es una imagen, creamos una URL local
     * para mostrarla en la Mesa de Luz.
     */
    const isImage =
      selectedFile.type.startsWith("image/");

    const image =
      isImage
        ? URL.createObjectURL(selectedFile)
        : "";

    /*
     * 4. La MISMA referencia entra en la Mesa
     * de Luz con el MISMO ID que tiene en el ADN.
     */
    addToLightTable({
      id: registeredReference.id,

      title: selectedFile.name,

      category: "Tu referencia",

      image,

      orientation: "landscape",

      description:
        registeredReference.description,

      keywords: [
        kind,
        "aportada",
        "usuario",
      ],
    });

    /*
     * 5. Limpiamos el formulario.
     */
    setSelectedFile(null);
    setMeaning("");
    setKind("visual");
    setIsOpen(false);

    if (fileInputRef.current) {
      fileInputRef.current.value = "";
    }
  };

  return (
    <section>

      {/* CABECERA */}

      <div>
        <p className="text-[10px] uppercase tracking-[0.32em] text-cyan-300">
          Tú aportas
        </p>

        <h2 className="mt-3 text-3xl font-light text-white">
          Añade tus referencias
        </h2>

        <p className="mt-4 max-w-xl leading-7 text-white/60">
          Incorpora imágenes, PDF, vídeos o
          cualquier material que forme parte
          de tu inspiración.
        </p>
      </div>

      {/* ZONA DE APORTACIÓN */}

      <div
        className="
          mt-8
          flex
          min-h-44
          items-center
          justify-center
          rounded-2xl
          border
          border-dashed
          border-white/10
          bg-black/20
          px-6
          py-8
        "
      >
        <div className="text-center">

          <p className="text-white/40">
            Arrastra aquí tus referencias
          </p>

          <button
            type="button"
            onClick={() => {
              setIsOpen(true);
              handleChooseFile();
            }}
            className="
              mt-5
              rounded-xl
              border
              border-cyan-300/40
              px-5
              py-3
              text-cyan-300
              transition
              hover:bg-cyan-300/10
            "
          >
            ＋ Aportar referencia
          </button>

          <input
            ref={fileInputRef}
            type="file"
            accept="image/*,application/pdf,video/*"
            onChange={handleFileChange}
            className="hidden"
          />

        </div>
      </div>

      {/* FORMULARIO */}

      {isOpen && (
        <div
          className="
            mt-6
            rounded-2xl
            border
            border-cyan-300/15
            bg-cyan-300/[0.035]
            p-6
          "
        >

          <p className="text-[10px] uppercase tracking-[0.32em] text-cyan-300">
            Nueva referencia
          </p>

          {/* ARCHIVO */}

          {selectedFile && (
            <div
              className="
                mt-5
                rounded-xl
                border
                border-white/10
                bg-black/20
                px-4
                py-4
              "
            >
              <p className="text-sm text-white">
                {selectedFile.name}
              </p>

              <p className="mt-1 text-xs text-white/35">
                {Math.round(
                  selectedFile.size / 1024
                )}{" "}
                KB
              </p>
            </div>
          )}

          {/* NATURALEZA */}

          <div className="mt-6">

            <p className="text-[10px] uppercase tracking-[0.28em] text-white/35">
              Naturaleza de la referencia
            </p>

            <div className="mt-3 flex flex-wrap gap-2">

              {referenceKinds.map(
                (referenceKind) => (
                  <button
                    key={referenceKind.value}
                    type="button"
                    onClick={() =>
                      setKind(
                        referenceKind.value
                      )
                    }
                    className={[
                      "rounded-full border px-4 py-2 text-xs transition",
                      kind ===
                      referenceKind.value
                        ? "border-cyan-300/60 bg-cyan-300/10 text-cyan-300"
                        : "border-white/10 text-white/45 hover:border-white/25 hover:text-white",
                    ].join(" ")}
                  >
                    {referenceKind.label}
                  </button>
                )
              )}

            </div>
          </div>

          {/* SIGNIFICADO */}

          <div className="mt-6">

            <label
              htmlFor="reference-meaning"
              className="text-[10px] uppercase tracking-[0.28em] text-white/35"
            >
              ¿Qué significa para ti?
            </label>

            <textarea
              id="reference-meaning"
              value={meaning}
              onChange={(event) =>
                setMeaning(
                  event.target.value
                )
              }
              rows={3}
              placeholder="Cuéntale a RƎVELA por qué esta referencia forma parte de tu inspiración."
              className="
                mt-3
                w-full
                resize-none
                rounded-xl
                border
                border-white/10
                bg-black/20
                px-4
                py-3
                text-sm
                leading-6
                text-white
                outline-none
                placeholder:text-white/25
                focus:border-cyan-300/40
              "
            />

          </div>

          {/* ACCIONES */}

          <div className="mt-6 flex items-center justify-between gap-4">

            <button
              type="button"
              onClick={() => {
                setSelectedFile(null);
                setMeaning("");
                setIsOpen(false);

                if (fileInputRef.current) {
                  fileInputRef.current.value = "";
                }
              }}
              className="
                text-xs
                uppercase
                tracking-[0.2em]
                text-white/35
                transition
                hover:text-white
              "
            >
              Cancelar
            </button>

            <button
              type="button"
              disabled={!selectedFile}
              onClick={handleRegister}
              className="
                rounded-xl
                border
                border-cyan-300/40
                bg-cyan-300/[0.06]
                px-5
                py-3
                text-xs
                uppercase
                tracking-[0.2em]
                text-cyan-300
                transition
                hover:bg-cyan-300/10
                disabled:cursor-default
                disabled:border-white/10
                disabled:text-white/20
              "
            >
              Añadir referencia
            </button>

          </div>

        </div>
      )}

      {/* CONTADOR */}

      {references.length > 0 && (
        <div
          className="
            mt-6
            flex
            items-center
            justify-between
            border-t
            border-white/10
            pt-5
          "
        >
          <span
            className="
              text-[10px]
              uppercase
              tracking-[0.28em]
              text-white/30
            "
          >
            Referencias aportadas
          </span>

          <span className="text-sm text-cyan-300">
            {references.length}
          </span>
        </div>
      )}

    </section>
  );
}